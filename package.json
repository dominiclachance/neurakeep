{
  "name": "neurakeep",
  "version": "0.3.2",
  "description": "NeuraKeep: local-first, source-cited memory for AI agents.",
  "type": "module",
  "bin": {
    "neurakeep": "dist/cli/index.js",
    "umos": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "build:all": "npm run build && npm run build:web",
    "check:secrets": "node scripts/security-scan.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5176",
    "e2e": "npm run build:all && node dist/cli/index.js init --root .umos && node dist/cli/index.js app --root .umos && playwright test",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run release:check && npm run typecheck && npm run build:all && npm test"
  },
  "keywords": [
    "memory",
    "mcp",
    "llm",
    "agents",
    "markdown",
    "sqlite"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "commander": "^14.0.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@cosmos.gl/graph": "^3.5.1",
    "@playwright/test": "^1.61.1",
    "@react-sigma/core": "^6.0.0",
    "@react-sigma/layout-forceatlas2": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-types": "^0.24.8",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sigma": "^4.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.12"
  },
  "mcpName": "io.github.dominiclachance/neurakeep",
  "files": [
    "dist",
    "web-dist",
    "docs",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominiclachance/neurakeep.git"
  },
  "homepage": "https://www.neurakeep.com/",
  "bugs": {
    "url": "https://github.com/dominiclachance/neurakeep/issues"
  }
}
